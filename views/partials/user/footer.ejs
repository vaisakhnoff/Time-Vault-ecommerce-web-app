<script>
    // Robust hero banner carousel initialization
    $(document).ready(function() {
        if (typeof $.fn.owlCarousel !== 'undefined' && $('.active-banner-slider').length) {
            if (!$('.active-banner-slider').hasClass('owl-loaded')) {
                $('.active-banner-slider').owlCarousel({
                    items: 1,
                    loop: true,
                    autoplay: true,
                    autoplayTimeout: 4500,
                    autoplayHoverPause: true,
                    smartSpeed: 700,
                    nav: true,
                    navText: ["<i class='ti-arrow-left'></i>", "<i class='ti-arrow-right'></i>"],
                    dots: true
                });
            }
        }
    });
    window.addEventListener('scroll', function() {
        const header = document.getElementById('vaultHeader');
        if (header) {
            if (window.scrollY > 30) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        }
    });

    const openSearch = document.getElementById('openSearchBtn');
    const searchBox = document.getElementById('search_input_box');
    const closeSearch = document.getElementById('close_search');

    if (openSearch && searchBox) {
        openSearch.addEventListener('click', function(e) {
            e.preventDefault();
            searchBox.classList.toggle('active');
            if (searchBox.classList.contains('active')) {
                document.getElementById('search_input').focus();
            }
        });
    }

    if (closeSearch && searchBox) {
        closeSearch.addEventListener('click', function() {
            searchBox.classList.remove('active');
        });
    }
</script>

</body>
