<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Time Vault | Admin Dashboard</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="Time Vault Luxury Watches Admin Panel">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="/img/fav.png">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Base Admin Assets -->
    <link href="/admin-assets/css/main.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="/admin-assets/css/modern-admin.css" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10.16.6/dist/sweetalert2.min.css">
    
    <!-- FontAwesome & Material Icons -->
    <script src="https://kit.fontawesome.com/16d4885483.js" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
    <div class="screen-overlay"></div>
    
    <!-- MODERN ADMIN SIDEBAR -->
    <aside class="navbar-aside" id="offcanvas_aside">
        <div class="aside-top">
            <a href="/admin/dashboard" class="tv-brand-logo">
                <div class="brand-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <h1 class="brand-name">TIME VAULT</h1>
                    <span class="brand-sub">Admin Console</span>
                </div>
            </a>
            <div>
                <button class="btn btn-icon btn-aside-minimize text-muted"> 
                    <i class="material-icons md-menu_open"></i> 
                </button>
            </div>
        </div>
        
        <nav>
            <div class="menu-category-divider">Overview</div>
            <ul class="menu-aside">
                <li class="menu-item">
                    <a class="menu-link" href="/admin/dashboard"> 
                        <i class="icon material-icons md-dashboard"></i>
                        <span class="text">Dashboard</span>
                    </a>
                </li>
            </ul>

            <div class="menu-category-divider">Inventory & Catalog</div>
            <ul class="menu-aside">
                <li class="menu-item">
                    <a class="menu-link" href="/admin/products"> 
                        <i class="icon material-icons md-shopping_bag"></i>
                        <span class="text">Products</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/category"> 
                        <i class="icon material-icons md-category"></i>
                        <span class="text">Categories</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/brands"> 
                        <i class="icon material-icons md-stars"></i>
                        <span class="text">Brands</span> 
                    </a>
                </li>
            </ul>

            <div class="menu-category-divider">Sales & Management</div>
            <ul class="menu-aside">
                <li class="menu-item">
                    <a class="menu-link" href="/admin/orders"> 
                        <i class="icon material-icons md-shopping_cart"></i>
                        <span class="text">Orders</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/return-requests"> 
                        <i class="icon material-icons md-assignment_return"></i>
                        <span class="text">Return Requests</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/users"> 
                        <i class="icon material-icons md-people"></i>
                        <span class="text">Customers</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/coupon"> 
                        <i class="icon material-icons md-local_offer"></i>
                        <span class="text">Coupons</span> 
                    </a>
                </li>
                <li class="menu-item">
                    <a class="menu-link" href="/admin/sales-report"> 
                        <i class="icon material-icons md-assessment"></i>
                        <span class="text">Sales Report</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- MAIN APP WRAPPER -->
    <main class="main-wrap">
        <!-- TOP HEADER NAVBAR -->
        <header class="main-header navbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-icon btn-mobile me-auto d-lg-none" data-trigger="#offcanvas_aside"> 
                    <i class="material-icons md-menu"></i> 
                </button>
                <div class="tv-breadcrumb-area d-none d-md-flex">
                    <span class="tv-page-badge">Admin Portal</span>
                    <span class="text-muted" style="font-size: 0.85rem;" id="current-date-display"></span>
                </div>
            </div>
            
            <div class="col-nav d-flex align-items-center gap-3">
                <div class="dropdown">
                    <div class="tv-admin-profile dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="adminProfileDrop">
                        <div class="tv-avatar-pill">A</div>
                        <div class="d-none d-sm-block text-start">
                            <div style="font-size: 0.85rem; font-weight: 600; line-height: 1.1; color: var(--tv-text-main);">Administrator</div>
                            <div style="font-size: 0.72rem; color: var(--tv-text-muted);">Super Admin</div>
                        </div>
                    </div>
                    <div class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="adminProfileDrop" style="border-radius: 12px; min-width: 180px; padding: 6px;">
                        <a class="dropdown-item text-danger d-flex align-items-center gap-2 p-2" href="/admin/logout">
                            <i class="material-icons md-exit_to_app" style="font-size: 1.1rem;"></i>
                            <span style="font-weight: 500;">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Active Route Detection Script -->
        <script>
            (function() {
                // Set formatted date
                try {
                    const dateElem = document.getElementById('current-date-display');
                    if (dateElem) {
                        const now = new Date();
                        dateElem.textContent = '• ' + now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
                    }
                } catch(e) {}

                // Highlight active nav item
                try {
                    const currentPath = window.location.pathname.toLowerCase();
                    const menuLinks = document.querySelectorAll('.menu-aside .menu-link');
                    menuLinks.forEach(link => {
                        const href = link.getAttribute('href').toLowerCase();
                        if (currentPath === href || (href !== '/admin/dashboard' && currentPath.startsWith(href))) {
                            link.closest('.menu-item').classList.add('active');
                        }
                    });
                } catch(e) {}
            })();
        </script>
