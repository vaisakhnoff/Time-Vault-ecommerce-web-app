<%- include("../../views/partials/user/header") %>

<!-- If there's an error message passed from the server, show a SweetAlert -->
<% if (typeof message !== 'undefined' && message) { %>
<script>
  Swal.fire({
    icon: 'error',
    title: 'Notice',
    text: '<%= message %>',
    confirmButtonColor: '#ff7700'
  });
</script>
<% } %>

<main class="vault-page-wrapper">
  <div class="container">
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/login">Sign In</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Recovery</span>
    </div>

    <div class="vault-card" style="max-width: 440px; margin: 0 auto; text-align: center;">
      <h4 style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Recover Vault Access</h4>
      <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Enter your registered email address to receive a secure recovery code.</p>

      <form action="/sendForgotOtp" method="POST" id="forgotForm" novalidate="novalidate">
        <div class="form-group mb-3 text-left">
          <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Registered Email Address</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="name@domain.com" required style="border-radius: 8px; padding: 12px 14px; border: 1px solid #e2e8f0;">
        </div>
        <div class="form-group mb-3">
          <button type="submit" class="vault-btn-primary w-100 justify-content-center" style="cursor: pointer;">
            <span>Send Recovery Code</span>
            <i class="ti-arrow-right"></i>
          </button>
        </div>
        <div class="form-group mb-0" style="font-size: 13px; color: #64748b;">
          Remembered credentials? <a href="/login" style="color: #ea580c; font-weight: 600;">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include("../../views/partials/user/footer") %>
