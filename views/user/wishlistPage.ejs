<%- include("../../views/partials/user/header") %>

<style>
.wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 24px;
}

.wishlist-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--vault-radius-md);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--vault-transition);
}

.wishlist-card:hover {
    border-color: rgba(245, 158, 11, 0.35);
    box-shadow: 0 15px 35px -5px rgba(15, 23, 42, 0.1);
    transform: translateY(-4px);
}

.wishlist-img-frame {
    height: 220px;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    position: relative;
}

.wishlist-img-frame img {
    max-height: 180px;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
}

.wishlist-card:hover .wishlist-img-frame img {
    transform: scale(1.06);
}

.wishlist-remove-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.2s;
}

.wishlist-remove-btn:hover {
    background: #fef2f2;
    color: #ef4444;
    border-color: #fecaca;
}

.wishlist-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
}

.wishlist-item-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 8px;
    line-height: 1.4;
}

.wishlist-item-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
}

.wishlist-item-title a:hover {
    color: #ea580c;
}

.wishlist-item-price {
    font-size: 18px;
    font-weight: 800;
    color: #ea580c;
    margin-bottom: 16px;
}
</style>

<main class="vault-page-wrapper">
    <div class="container">
        <!-- Breadcrumb Pill -->
        <div class="vault-breadcrumb-pill">
            <a href="/">Home</a>
            <span class="sep"><i class="ti-angle-right"></i></span>
            <a href="/shopPage">Collections</a>
            <span class="sep"><i class="ti-angle-right"></i></span>
            <span class="active-crumb">My Wishlist</span>
        </div>

        <!-- Header Title -->
        <div class="mb-4">
            <h1 class="vault-page-title">Curated <span class="vault-gold-text">Wishlist</span></h1>
            <p class="vault-page-subtitle">Personal bookmarks of horological icons and certified mechanical timepieces.</p>
        </div>

        <% if (wishlist && wishlist.products && wishlist.products.length > 0) { %>
            <div class="wishlist-grid">
                <% wishlist.products.forEach(function(item) { %>
                    <% if (item && item.productId) { %>
                        <div class="wishlist-card">
                            <div class="wishlist-img-frame">
                                <button type="button" class="wishlist-remove-btn" title="Remove from wishlist" onclick="removeFromWishlist('<%= item.productId._id %>')">
                                    <i class="ti-close" style="font-size: 12px;"></i>
                                </button>
                                <a href="/productDetails?id=<%= item.productId._id %>">
                                    <% if (item.productId.productImage && item.productId.productImage[0]) { %>
                                        <img src="/uploads/product-images/<%= item.productId.productImage[0] %>" 
                                             alt="<%= item.productId.productName || 'Product Image' %>" />
                                    <% } else { %>
                                        <img src="/img/default-product.jpg" alt="Default Product Image" />
                                    <% } %>
                                </a>
                            </div>

                            <div class="wishlist-body">
                                <div>
                                    <div class="wishlist-item-title">
                                        <a href="/productDetails?id=<%= item.productId._id %>">
                                            <%= item.productId.productName || 'Product Name Not Available' %>
                                        </a>
                                    </div>
                                    <div class="wishlist-item-price">
                                        ₹<%= (item.productId.salePrice || 0).toFixed(2) %>
                                    </div>
                                </div>

                                <button class="vault-btn-primary w-100 justify-content-center" style="padding: 10px 18px; font-size: 13px;" onclick="addToCart('<%= item.productId._id %>')">
                                    <i class="ti-bag"></i>
                                    <span>Move to Bag</span>
                                </button>
                            </div>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        <% } else { %>
            <div class="vault-card text-center py-5">
                <div style="width: 70px; height: 70px; border-radius: 50%; background: #fff7ed; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="ti-heart" style="font-size: 32px; color: #ff7700;"></i>
                </div>
                <h4 style="font-weight: 700; color: #0f172a; margin-bottom: 8px;">Your Wishlist is Empty</h4>
                <p style="color: #64748b; max-width: 400px; margin: 0 auto 24px;">Explore the Master Collection and bookmark your preferred luxury timepieces.</p>
                <a href="/shopPage" class="vault-btn-primary">
                    <span>Explore Master Collection</span>
                    <i class="ti-arrow-right"></i>
                </a>
            </div>
        <% } %>
    </div>
</main>

<script>
    function addToCart(productId) {
        fetch('/addToCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: productId, fromWishlist: true })
        })
        .then(async response => {
            if (response.status === 401 || response.redirected) {
                window.location.href = '/login';
                return;
            }
            const data = await response.json();
            if (data && data.redirect) {
                window.location.href = data.redirect;
                return;
            }
            Swal.fire({
                icon: data.success ? 'success' : 'error',
                title: data.success ? 'Allocated to Bag' : 'Notice',
                text: data.message || (data.success ? 'Product added to cart!' : 'Something went wrong'),
                confirmButtonColor: '#ff7700'
            }).then(() => { if (data.success) location.reload(); });
        })
        .catch(() => Swal.fire('Error', 'Something went wrong', 'error'));
    }

    function removeFromWishlist(productId) {
        fetch('/removeFromWishlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        })
        .then(response => response.json())
        .then(data => {
            Swal.fire({
                icon: data.success ? 'success' : 'error',
                title: data.success ? 'Removed' : 'Notice',
                text: data.success ? 'Product removed from wishlist!' : data.message,
                timer: 1500,
                showConfirmButton: false
            }).then(() => { if (data.success) location.reload(); });
        })
        .catch(() => Swal.fire('Error', 'Something went wrong', 'error'));
    }
</script>

<%- include("../../views/partials/user/footer") %>