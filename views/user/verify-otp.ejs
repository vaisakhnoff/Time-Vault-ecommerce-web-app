<%- include("../../views/partials/user/header") %>

<main class="vault-page-wrapper">
  <div class="container">
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Verify Registration</span>
    </div>

    <div class="vault-card" style="max-width: 440px; margin: 0 auto; text-align: center;">
      <h4 style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Verify Your Account</h4>
      <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Enter the verification code sent to your email to complete registration.</p>

      <form action="/verify-otp" method="POST" id="otpForm" novalidate="novalidate" onsubmit="return verifyOtp()">
        <div class="form-group mb-3">
          <input type="text" class="form-control" id="otp" name="otp" placeholder="Enter 6-digit OTP" required style="border-radius: 8px; padding: 12px 14px; text-align: center; letter-spacing: 4px; font-weight: 700; font-size: 18px; border: 1px solid #e2e8f0;">
        </div>
        <div class="form-group mb-3">
          <button type="submit" class="vault-btn-primary w-100 justify-content-center" style="cursor: pointer;">Verify OTP</button>
        </div>
        <div class="form-group mb-2">
          <button type="button" class="vault-btn-glass w-100 justify-content-center" id="resendOtpBtn" style="cursor: pointer; font-size: 13px;">Resend OTP</button>
        </div>
        <!-- Timer display -->
        <div class="form-group my-3">
          <span id="timerDisplay" style="font-size: 14px; font-weight: 600; color: #ea580c;"></span>
        </div>
        <div class="form-group mb-0" style="font-size: 13px; color: #64748b;">
          Already verified? <a href="/login" style="color: #ea580c; font-weight: 600;">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
    
    document.addEventListener('DOMContentLoaded', function () {
      let resendOtpBtn = document.getElementById('resendOtpBtn');
      let timerDisplay = document.getElementById('timerDisplay');
      let timeLeft = 59;
  
     
      resendOtpBtn.disabled = true;
      timerDisplay.textContent = `Resend OTP in ${timeLeft} seconds`;
  
      const countdown = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          clearInterval(countdown);
          timerDisplay.textContent = "";
          resendOtpBtn.disabled = false;
        } else {
          timerDisplay.textContent = `Resend OTP in ${timeLeft} seconds`;
        }
      }, 1000);
  
      
      resendOtpBtn.addEventListener('click', function () {
        $.ajax({
            type: "POST",
            url: "/resend-otp",
            dataType: "json",
            success: function(response) {
                if (response.success) {
                    alert("OTP has been resent.");
                    // Restart the timer
                    timeLeft = 59;
                    resendOtpBtn.disabled = true;
                    timerDisplay.textContent = `Resend OTP in ${timeLeft} seconds`;
                    const restartCountdown = setInterval(() => {
                        timeLeft--;
                        if (timeLeft <= 0) {
                            clearInterval(restartCountdown);
                            timerDisplay.textContent = "";
                            resendOtpBtn.disabled = false;
                        } else {
                            timerDisplay.textContent = `Resend OTP in ${timeLeft} seconds`;
                        }
                    }, 1000);
                } else {
                    alert(response.message || "Failed to resend OTP. Please try again.");
                }
            },
            error: function(xhr) {
                let res = xhr.responseJSON;
                if (res && res.message) {
                    alert(res.message);
                } else {
                    alert("An unexpected error occurred.");
                }
            }
        });
    });
});

function verifyOtp(){
      const otpinput = document.getElementById("otp").value;
      $.ajax({
        type:"POST",
        url:"/verify-otp",
        data: { otp: otpinput },
        dataType: "json", // 
        success:function(response){
          if(response.success){
            alert("OTP verified successfully. You can now login.");
            window.location.href = response.redirectUrl;
          } else {
            alert("Invalid OTP. Please try again.");
          }
        },
        error: function(xhr) {
          let res = xhr.responseJSON;
          if(res && res.message) {
            alert(res.message);
          } else {
            alert("An unexpected error occurred.");
          }
        }
      });
      return false; // Prevent form submission
    }
  </script>

<%- include("../../views/partials/user/footer") %>
