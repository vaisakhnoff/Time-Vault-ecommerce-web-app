<%- include("../../views/partials/user/header") %>

<!-- ==========================================================================
     SHOP CATALOG HERO & QUICK SEARCH (CLEAN WHITE & GOLD)
     ========================================================================== -->
<section class="vault-shop-hero">
    <div class="container">
        <div class="text-center mb-4">
            <span class="vault-section-tag">Vault Archive &bull; Curated Timepieces</span>
            <h1 class="vault-section-title">The <span class="vault-gold-text">Master Collection</span></h1>
            <p class="vault-section-desc">Search, filter, and discover certified luxury chronometers, mechanical calibres, and smart instruments.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <form id="topSearchForm" class="vault-search-glass" action="/shopPage" method="GET">
                    <i class="ti-search mr-3" style="font-size: 18px; color: #ea580c;"></i>
                    <input type="text" 
                           id="searchInput" 
                           name="search" 
                           placeholder="Search Rolex, Carrera, Chronometer, Titanium, Smart..." 
                           value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    <button type="button" class="btn btn-link text-muted p-0 mr-2" id="clearSearch" style="display: none;">
                        <i class="ti-close"></i>
                    </button>
                    <button type="submit" class="search-submit-btn" title="Execute Search">
                        <i class="ti-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     CATALOG MAIN CONTAINER
     ========================================================================== -->
<div class="container py-5">
    <div class="row">
        <!-- Glass Filter Sidebar -->
        <div class="col-lg-3 col-md-4 mb-4">
            <aside class="vault-sidebar">
                <div class="vault-filter-header">
                    <span><i class="ti-filter mr-2" style="color: #ea580c;"></i>Refine Vault</span>
                    <button type="button" class="btn btn-link text-muted p-0" onclick="clearFilters()" style="font-size: 12px; text-decoration: none;">
                        <i class="ti-reload mr-1"></i>Reset
                    </button>
                </div>

                <form id="filterForm">
                    <!-- Category Domains -->
                    <div class="vault-filter-group">
                        <div class="vault-filter-label">Horological Domain</div>
                        <ul class="vault-filter-list">
                            <li class="vault-filter-item <%= !selectedCategory ? 'active' : '' %>">
                                <label>
                                    <input type="radio" name="category" value="" <%= !selectedCategory ? 'checked' : '' %> style="display: none;">
                                    <span>All Domains</span>
                                    <i class="ti-angle-right" style="font-size: 11px;"></i>
                                </label>
                            </li>
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach(function(cat) { %>
                                    <li class="vault-filter-item <%= (selectedCategory == cat._id.toString() || selectedCategory == cat.name) ? 'active' : '' %>">
                                        <label>
                                            <input type="radio" name="category" value="<%= cat._id %>" <%= (selectedCategory == cat._id.toString() || selectedCategory == cat.name) ? 'checked' : '' %> style="display: none;">
                                            <span><%= cat.name %></span>
                                            <i class="ti-angle-right" style="font-size: 11px;"></i>
                                        </label>
                                    </li>
                                <% }); %>
                            <% } %>
                        </ul>
                    </div>

                    <!-- Ateliers & Brands -->
                    <div class="vault-filter-group">
                        <div class="vault-filter-label">Atelier / Brand</div>
                        <div class="vault-brand-chips">
                            <label class="vault-brand-chip <%= !selectedBrand ? 'active' : '' %>">
                                <input type="radio" name="brand" value="" <%= !selectedBrand ? 'checked' : '' %> style="display: none;">
                                All Brands
                            </label>
                            <% if (brands && brands.length > 0) { %>
                                <% brands.forEach(function(brand) { %>
                                    <label class="vault-brand-chip <%= (selectedBrand == brand._id.toString() || selectedBrand == brand.brandName) ? 'active' : '' %>">
                                        <input type="radio" name="brand" value="<%= brand._id %>" <%= (selectedBrand == brand._id.toString() || selectedBrand == brand.brandName) ? 'checked' : '' %> style="display: none;">
                                        <%= brand.brandName %>
                                    </label>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>

                    <!-- Price Range -->
                    <div class="vault-filter-group">
                        <div class="vault-filter-label">Valuation Range (₹)</div>
                        <div class="d-flex align-items-center mb-3" style="gap: 8px;">
                            <input type="number" 
                                   name="minPrice" 
                                   id="minPrice" 
                                   class="form-control" 
                                   placeholder="Min ₹" 
                                   value="<%= minPrice %>" 
                                   style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a; border-radius: 8px; font-size: 13px;">
                            <span class="text-muted">-</span>
                            <input type="number" 
                                   name="maxPrice" 
                                   id="maxPrice" 
                                   class="form-control" 
                                   placeholder="Max ₹" 
                                   value="<%= maxPrice %>" 
                                   style="background: #f8fafc; border: 1px solid #e2e8f0; color: #0f172a; border-radius: 8px; font-size: 13px;">
                        </div>
                        <button type="submit" class="vault-btn-primary w-100 justify-content-center" style="padding: 10px 16px; font-size: 13px;">
                            Apply Filters
                        </button>
                    </div>
                </form>
            </aside>
        </div>

        <!-- Product Grid Column -->
        <div class="col-lg-9 col-md-8">
            <!-- Top Bar: Result Count & Sort Selector -->
            <div class="vault-catalog-topbar">
                <div style="font-size: 14px; color: var(--vault-text-secondary);">
                    Showing <span class="font-weight-bold" id="productCount" style="color: #0f172a;"><%= products ? products.length : 0 %></span> Pieces in Selection
                </div>

                <div class="d-flex align-items-center" style="gap: 10px;">
                    <span style="font-size: 13px; color: var(--vault-text-muted);">Sort By:</span>
                    <select id="sortSelect" class="vault-sort-select" onchange="handleSortChange(this.value)">
                        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Latest Releases</option>
                        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="name_asc" <%= sort === 'name_asc' ? 'selected' : '' %>>Piece Name: A to Z</option>
                        <option value="name_desc" <%= sort === 'name_desc' ? 'selected' : '' %>>Piece Name: Z to A</option>
                    </select>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="row" id="productList">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(product) { %>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="vault-product-card h-100">
                                <div class="vault-product-media">
                                    <img src="<%= (product.productImage && product.productImage[0]) ? product.productImage[0] : '/uploads/product-images/placeholder.jpg' %>" 
                                         alt="<%= product.productName %>"
                                         onerror="this.src='/uploads/product-images/placeholder.jpg'">

                                    <div class="vault-card-badges">
                                        <% const brandTitle = (product.brand && (product.brand.brandName || (typeof product.brand === 'string' && !/^[0-9a-fA-F]{24}$/.test(product.brand) ? product.brand : null))); %>
                                        <% if (brandTitle) { %>
                                            <span class="vault-badge-brand"><%= brandTitle %></span>
                                        <% } %>
                                        <% if (product.salePrice && product.salePrice < product.regularPrice) { %>
                                            <% const discount = Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100); %>
                                            <span class="vault-badge-discount">-<%= discount %>%</span>
                                        <% } %>
                                    </div>

                                    <div class="vault-product-actions">
                                        <a href="/productDetails?id=<%= product._id %>" class="vault-icon-action" title="Inspect Timepiece">
                                            <i class="ti-eye"></i>
                                        </a>
                                        <a href="#" onclick="event.preventDefault(); addToCart('<%= product._id %>');" class="vault-icon-action" title="Add to Bag">
                                            <i class="ti-bag"></i>
                                        </a>
                                        <a href="#" onclick="event.preventDefault(); addToWishlist('<%= product._id %>');" class="vault-icon-action" title="Save to Wishlist">
                                            <i class="ti-heart"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="vault-product-info">
                                    <div class="vault-product-cat-label">
                                        <%= (product.category && product.category.name) ? product.category.name : 'Horology' %>
                                    </div>
                                    <a href="/productDetails?id=<%= product._id %>" class="vault-product-name" title="<%= product.productName %>">
                                        <%= product.productName %>
                                    </a>

                                    <div class="vault-pricing-row">
                                        <% if (product.salePrice && product.salePrice < product.regularPrice) { %>
                                            <span class="vault-price-current">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></span>
                                            <span class="vault-price-original">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></span>
                                        <% } else { %>
                                            <span class="vault-price-current">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></span>
                                        <% } %>
                                    </div>

                                    <div class="vault-stock-indicator <%= (product.quantity > 5) ? 'in-stock' : 'low-stock' %>">
                                        <span class="dot"></span>
                                        <span><%= (product.quantity > 5) ? 'Available in Vault' : 'Only ' + product.quantity + ' left' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <div class="glass-panel p-5 d-inline-block" style="max-width: 480px;">
                            <i class="ti-search mr-2" style="font-size: 3rem; color: #ea580c;"></i>
                            <h4 class="mt-3">No Timepieces Found</h4>
                            <p class="text-muted">No vault items matched your filter criteria. Try broadening your parameters.</p>
                            <button class="vault-btn-primary mt-2" onclick="clearFilters()">Reset All Filters</button>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Glass Pagination -->
            <div id="paginationContainer">
                <% if (totalPages > 1) { %>
                    <div class="vault-pagination">
                        <% if (currentPage > 1) { %>
                            <a href="#" class="vault-page-pill" onclick="changePage(<%= currentPage - 1 %>); return false;">
                                <i class="ti-arrow-left"></i>
                            </a>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a href="#" class="vault-page-pill <%= currentPage == i ? 'active' : '' %>" onclick="changePage(<%= i %>); return false;">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="#" class="vault-page-pill" onclick="changePage(<%= currentPage + 1 %>); return false;">
                                <i class="ti-arrow-right"></i>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include("../../views/partials/user/footer") %>

<!-- ==========================================================================
     CLIENT FILTER & AJAX CONTROLLERS
     ========================================================================== -->
<script>
async function updateProductList(params) {
    try {
        const response = await fetch(`/shopPage?${params.toString()}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        const data = await response.json();

        const productList = document.getElementById('productList');
        const productCount = document.getElementById('productCount');
        productList.innerHTML = '';

        if (productCount) {
            productCount.textContent = data.products ? data.products.length : 0;
        }

        if (data.products && data.products.length > 0) {
            data.products.forEach(product => {
                const brandName = (product.brand && product.brand.brandName) ? product.brand.brandName : (typeof product.brand === 'string' && !/^[0-9a-fA-F]{24}$/.test(product.brand) ? product.brand : '');
                const catName = (product.category && product.category.name) ? product.category.name : 'Horology';
                const imgSrc = (product.productImage && product.productImage[0]) ? product.productImage[0] : '/uploads/product-images/placeholder.jpg';
                
                let pricingHtml = '';
                let discountBadge = '';
                if (product.salePrice && product.salePrice < product.regularPrice) {
                    const discount = Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100);
                    discountBadge = `<span class="vault-badge-discount">-${discount}%</span>`;
                    pricingHtml = `
                        <span class="vault-price-current">₹${Number(product.salePrice).toLocaleString('en-IN')}</span>
                        <span class="vault-price-original">₹${Number(product.regularPrice).toLocaleString('en-IN')}</span>
                    `;
                } else {
                    pricingHtml = `<span class="vault-price-current">₹${Number(product.regularPrice).toLocaleString('en-IN')}</span>`;
                }

                const stockClass = (product.quantity > 5) ? 'in-stock' : 'low-stock';
                const stockText = (product.quantity > 5) ? 'Available in Vault' : `Only ${product.quantity} left`;

                const productHtml = `
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="vault-product-card h-100">
                            <div class="vault-product-media">
                                <img src="${imgSrc}" alt="${product.productName}" onerror="this.src='/uploads/product-images/placeholder.jpg'">
                                <div class="vault-card-badges">
                                    ${brandName ? `<span class="vault-badge-brand">${brandName}</span>` : ''}
                                    ${discountBadge}
                                </div>
                                <div class="vault-product-actions">
                                    <a href="/productDetails?id=${product._id}" class="vault-icon-action" title="Inspect Timepiece">
                                        <i class="ti-eye"></i>
                                    </a>
                                    <a href="#" onclick="event.preventDefault(); addToCart('${product._id}');" class="vault-icon-action" title="Add to Bag">
                                        <i class="ti-bag"></i>
                                    </a>
                                    <a href="#" onclick="event.preventDefault(); addToWishlist('${product._id}');" class="vault-icon-action" title="Save to Wishlist">
                                        <i class="ti-heart"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="vault-product-info">
                                <div class="vault-product-cat-label">${catName}</div>
                                <a href="/productDetails?id=${product._id}" class="vault-product-name" title="${product.productName}">
                                    ${product.productName}
                                </a>
                                <div class="vault-pricing-row">
                                    ${pricingHtml}
                                </div>
                                <div class="vault-stock-indicator ${stockClass}">
                                    <span class="dot"></span>
                                    <span>${stockText}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                productList.insertAdjacentHTML('beforeend', productHtml);
            });
        } else {
            productList.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="glass-panel p-5 d-inline-block" style="max-width: 480px;">
                        <i class="ti-search mr-2" style="font-size: 3rem; color: #ea580c;"></i>
                        <h4 class="mt-3">No Timepieces Found</h4>
                        <p class="text-muted">No vault items matched your filter criteria. Try broadening your parameters.</p>
                        <button class="vault-btn-primary mt-2" onclick="clearFilters()">Reset All Filters</button>
                    </div>
                </div>
            `;
        }

        const paginationContainer = document.getElementById('paginationContainer');
        paginationContainer.innerHTML = '';
        if (data.totalPages > 1) {
            let pagHtml = '<div class="vault-pagination">';
            if (data.currentPage > 1) {
                pagHtml += `<a href="#" class="vault-page-pill" onclick="changePage(${data.currentPage - 1}); return false;"><i class="ti-arrow-left"></i></a>`;
            }
            for (let i = 1; i <= data.totalPages; i++) {
                pagHtml += `<a href="#" class="vault-page-pill ${data.currentPage == i ? 'active' : ''}" onclick="changePage(${i}); return false;">${i}</a>`;
            }
            if (data.currentPage < data.totalPages) {
                pagHtml += `<a href="#" class="vault-page-pill" onclick="changePage(${data.currentPage + 1}); return false;"><i class="ti-arrow-right"></i></a>`;
            }
            pagHtml += '</div>';
            paginationContainer.innerHTML = pagHtml;
        }

        updateUrl(params);
    } catch (error) {
        console.error('Error updating vault catalog:', error);
    }
}

function updateUrl(params) {
    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.pushState({}, '', newUrl);
}

function changePage(page) {
    const params = new URLSearchParams(window.location.search);
    params.set('page', page);
    updateProductList(params);
    window.scrollTo({ top: 300, behavior: 'smooth' });
}

function handleSortChange(sortVal) {
    const params = new URLSearchParams(window.location.search);
    params.set('sort', sortVal);
    params.set('page', '1');
    updateProductList(params);
}

document.getElementById('topSearchForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const searchQuery = document.getElementById('searchInput').value.trim();
    const params = new URLSearchParams(window.location.search);
    if (searchQuery) {
        params.set('search', searchQuery);
    } else {
        params.delete('search');
    }
    params.set('page', '1');
    updateProductList(params);
});

document.querySelectorAll('#filterForm input[name="category"], #filterForm input[name="brand"]').forEach(radio => {
    radio.addEventListener('change', function() {
        const formData = new FormData(document.getElementById('filterForm'));
        const params = new URLSearchParams(window.location.search);
        
        const cat = formData.get('category');
        if (cat) params.set('category', cat); else params.delete('category');
        
        const brand = formData.get('brand');
        if (brand) params.set('brand', brand); else params.delete('brand');

        params.set('page', '1');
        updateProductList(params);

        document.querySelectorAll('.vault-filter-item').forEach(el => el.classList.remove('active'));
        if (radio.name === 'category') {
            radio.closest('.vault-filter-item').classList.add('active');
        }
        if (radio.name === 'brand') {
            document.querySelectorAll('.vault-brand-chip').forEach(el => el.classList.remove('active'));
            radio.closest('.vault-brand-chip').classList.add('active');
        }
    });
});

document.getElementById('filterForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const minVal = document.getElementById('minPrice').value;
    const maxVal = document.getElementById('maxPrice').value;
    const params = new URLSearchParams(window.location.search);

    if (minVal) params.set('minPrice', minVal); else params.delete('minPrice');
    if (maxVal) params.set('maxPrice', maxVal); else params.delete('maxPrice');
    params.set('page', '1');
    updateProductList(params);
});

function clearFilters() {
    document.getElementById('filterForm').reset();
    document.getElementById('searchInput').value = '';
    const params = new URLSearchParams();
    updateProductList(params);
    document.querySelectorAll('.vault-filter-item').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.vault-brand-chip').forEach(el => el.classList.remove('active'));
}

function addToWishlist(productId) {
    fetch('/addWishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: productId })
    })
    .then(r => r.json())
    .then(data => {
        Swal.fire({
            icon: data.success ? 'success' : 'info',
            title: data.success ? 'Added to Wishlist' : 'Notice',
            text: data.message,
            confirmButtonColor: '#ff7700'
        });
    })
    .catch(() => {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong' });
    });
}

function addToCart(productId) {
    fetch('/addToCart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: productId })
    })
    .then(async response => {
        if (response.status === 401 || response.redirected) {
            window.location.href = '/login';
            return;
        }
        const data = await response.json();
        if (data && data.redirect) {
            window.location.href = data.redirect;
            return;
        }
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Added to Bag',
                text: data.message,
                timer: 2000,
                showConfirmButton: false
            });
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Notice',
                text: data.message,
                confirmButtonColor: '#ff7700'
            });
        }
    })
    .catch(() => {
        Swal.fire({ icon: 'error', title: 'Cart Error', text: 'Failed to update bag' });
    });
}
</script>