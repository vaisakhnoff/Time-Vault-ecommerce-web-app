<%- include("../../views/partials/user/header") %>

<main class="vault-page-wrapper">
  <div class="container text-center">
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/orders">Orders</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Acquisition Confirmed</span>
    </div>

    <div class="vault-card" style="max-width: 580px; margin: 0 auto; padding: 40px 30px;">
      <div style="width: 80px; height: 80px; border-radius: 50%; background: #f0fdf4; border: 1px solid #bbf7d0; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
        <i class="ti-check" style="font-size: 36px; color: #16a34a;"></i>
      </div>

      <h2 style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Allocation Confirmed</h2>
      <p style="color: #64748b; font-size: 15px; margin-bottom: 24px;">Your order has been recorded in the Vault registry and dispatched for white-glove transit preparation.</p>

      <div class="p-3 mb-4 text-left" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
        <div class="d-flex justify-content-between mb-2" style="font-size: 14px;">
          <span class="text-muted">Order Identifier:</span>
          <strong style="color: #0f172a;">#<%= order.orderId %></strong>
        </div>
        <div class="d-flex justify-content-between" style="font-size: 14px;">
          <span class="text-muted">Allocated Amount:</span>
          <strong style="color: #ea580c; font-size: 16px;">₹<%= order.totalAmount.toFixed(2) %></strong>
        </div>
      </div>

      <div class="d-flex justify-content-center flex-wrap" style="gap: 12px;">
        <a href="/orders" class="vault-btn-primary" style="padding: 12px 28px;">
          <i class="ti-package mr-1"></i>
          <span>Track Order</span>
        </a>
        <a href="/shopPage" class="vault-btn-glass" style="padding: 12px 28px;">
          <span>Explore Vault</span>
        </a>
      </div>
    </div>
  </div>
</main>

<%- include("../../views/partials/user/footer") %>
