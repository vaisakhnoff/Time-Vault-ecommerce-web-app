<%- include("../../views/partials/user/header") %>

<main class="vault-page-wrapper">
  <div class="container">
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/login">Sign In</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Reset Security Key</span>
    </div>

    <div class="vault-card" style="max-width: 440px; margin: 0 auto; text-align: center;">
      <h4 style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Create New Security Key</h4>
      <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Ensure your new password meets horological encryption standards.</p>

      <% if (message) { %>
        <div class="alert alert-danger mb-3" style="font-size: 13px;"><%= message %></div>
      <% } %>

      <form action="/resetPassword" method="POST" id="resetPasswordForm" novalidate="novalidate">
        <div class="form-group mb-3 text-left">
          <label style="font-weight: 600; color: #0f172a; font-size: 13px;">New Password</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="Minimum 8 characters" required style="border-radius: 8px; padding: 12px 14px; border: 1px solid #e2e8f0;">
        </div>
        <div class="form-group mb-3 text-left">
          <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Confirm New Password</label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Re-enter new password" required style="border-radius: 8px; padding: 12px 14px; border: 1px solid #e2e8f0;">
        </div>
        <div class="form-group mb-3">
          <button type="submit" class="vault-btn-primary w-100 justify-content-center" style="cursor: pointer;">
            <span>Update Security Key</span>
            <i class="ti-arrow-right"></i>
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include("../../views/partials/user/footer") %>
