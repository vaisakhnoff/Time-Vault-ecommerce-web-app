<%- include("../../views/partials/user/header") %>

<style>
  .cart-item-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--vault-radius-md);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .cart-table th {
    background: #f8fafc;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: none;
    padding: 16px 20px;
  }
  .cart-table td {
    vertical-align: middle;
    padding: 20px;
    border-top: 1px solid #f1f5f9;
  }
  .product-thumb-box {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .product-thumb-box img {
    max-height: 70px;
    max-width: 70px;
    object-fit: contain;
  }
  .vault-qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    background: #f8fafc;
    padding: 4px;
  }
  .vault-qty-stepper button {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .vault-qty-stepper button:hover {
    background: #fff7ed;
    color: #ea580c;
  }
  .vault-qty-stepper input {
    width: 40px;
    text-align: center;
    border: none;
    background: transparent;
    font-weight: 700;
    color: #0f172a;
    font-size: 14px;
    outline: none;
  }
  .vault-remove-pill {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fee2e2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .vault-remove-pill:hover {
    background: #ef4444;
    color: #ffffff;
    transform: scale(1.05);
  }
  @media (max-width: 768px) {
    .cart-table thead { display: none; }
    .cart-table tbody tr { display: block; padding: 15px; margin-bottom: 15px; border: 1px solid #e2e8f0; border-radius: 14px; }
    .cart-table td { display: flex; justify-content: space-between; align-items: center; border: none; padding: 8px 0; }
  }
</style>

<main class="vault-page-wrapper">
  <div class="container">
    <!-- Breadcrumb Pill -->
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/shopPage">Collections</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Shopping Bag</span>
    </div>

    <!-- Header Title -->
    <div class="mb-4">
      <h1 class="vault-page-title">Shopping <span class="vault-gold-text">Bag</span></h1>
      <p class="vault-page-subtitle">Review your selected luxury timepieces and proceed to allocation.</p>
    </div>

    <% if (cart && cart.items && cart.items.length > 0) { %>
      <div class="row">
        <!-- Cart Items Table Column -->
        <div class="col-lg-8 mb-4">
          <div class="cart-item-card">
            <div class="table-responsive">
              <table class="table cart-table mb-0">
                <thead>
                  <tr>
                    <th>Timepiece</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% cart.items.forEach(function(item) { %>
                    <tr data-product-id="<%= item.productId._id %>">
                      <td data-label="Product">
                        <div class="d-flex align-items-center" style="gap: 16px;">
                          <div class="product-thumb-box">
                            <% if (item.productId && item.productId.productImage && item.productId.productImage.length > 0) { %>
                              <img src="<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>">
                            <% } else { %>
                              <i class="ti-time text-muted" style="font-size: 24px;"></i>
                            <% } %>
                          </div>
                          <div>
                            <h6 class="mb-1" style="font-weight: 700; color: #0f172a; font-size: 15px;">
                              <a href="/productDetails?id=<%= item.productId._id %>" style="color: inherit; text-decoration: none;">
                                <%= item.productId.productName %>
                              </a>
                            </h6>
                            <small class="text-muted">Certified Authentic &bull; Swiss Spec</small>
                          </div>
                        </div>
                      </td>
                      <td data-label="Price">
                        <span style="font-weight: 600; color: #475569;">₹<%= item.price.toFixed(2) %></span>
                      </td>
                      <td data-label="Quantity">
                        <div class="vault-qty-stepper product_count">
                          <button class="reduced items-count" type="button"><i class="ti-minus" style="font-size: 10px;"></i></button>
                          <input type="text" name="qty" class="input-text qty" value="<%= item.quantity %>" readonly>
                          <button class="increase items-count" type="button"><i class="ti-plus" style="font-size: 10px;"></i></button>
                        </div>
                      </td>
                      <td data-label="Total">
                        <span class="item-total" style="font-weight: 700; color: #0f172a; font-size: 15px;">
                          ₹<%= (item.price * item.quantity).toFixed(2) %>
                        </span>
                      </td>
                      <td data-label="Action" style="text-align: right;">
                        <button type="button" class="vault-remove-pill remove-btn" data-product-id="<%= item.productId._id %>" title="Remove Item">
                          <i class="ti-trash" style="font-size: 14px;"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap" style="gap: 10px;">
            <a href="/shopPage" class="vault-btn-glass" style="font-size: 14px; padding: 10px 22px;">
              <i class="ti-arrow-left"></i>
              <span>Continue Shopping</span>
            </a>
          </div>
        </div>

        <!-- Order Summary Sidebar Column -->
        <div class="col-lg-4">
          <div class="vault-card">
            <h5 style="font-weight: 700; color: #0f172a; margin-bottom: 20px;">Allocation Summary</h5>
            
            <div class="d-flex justify-content-between mb-2" style="font-size: 14px; color: #64748b;">
              <span>Subtotal</span>
              <span id="subtotal" style="font-weight: 700; color: #0f172a;">
                ₹<%= cart.items.reduce((sum, item) => sum + (item.price * item.quantity), 0).toFixed(2) %>
              </span>
            </div>
            
            <div class="d-flex justify-content-between mb-3" style="font-size: 14px; color: #64748b;">
              <span>Insured Transit</span>
              <span style="color: #16a34a; font-weight: 600;">Complimentary</span>
            </div>

            <div class="dropdown-divider my-3" style="border-color: #f1f5f9;"></div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <span style="font-size: 16px; font-weight: 700; color: #0f172a;">Total Amount</span>
              <span style="font-size: 20px; font-weight: 800; color: #ea580c;">
                ₹<%= cart.items.reduce((sum, item) => sum + (item.price * item.quantity), 0).toFixed(2) %>
              </span>
            </div>

            <a href="/checkoutPage" class="vault-btn-primary w-100 justify-content-center" style="padding: 14px 20px;">
              <span>Proceed to Checkout</span>
              <i class="ti-arrow-right"></i>
            </a>

            <div class="mt-3 text-center" style="color: #94a3b8; font-size: 12px;">
              <i class="ti-lock mr-1 text-warning"></i> Encrypted 256-bit White-Glove Dispatch
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="vault-card text-center py-5">
        <div style="width: 70px; height: 70px; border-radius: 50%; background: #fff7ed; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
          <i class="ti-bag" style="font-size: 32px; color: #ff7700;"></i>
        </div>
        <h4 style="font-weight: 700; color: #0f172a; margin-bottom: 8px;">Your Shopping Bag is Empty</h4>
        <p style="color: #64748b; max-width: 400px; margin: 0 auto 24px;">Discover our certified mechanical calibres and luxury chronometers in the vault archive.</p>
        <a href="/shopPage" class="vault-btn-primary">
          <span>Explore Master Collection</span>
          <i class="ti-arrow-right"></i>
        </a>
      </div>
    <% } %>
  </div>
</main>

<script>
document.querySelectorAll('.remove-btn').forEach(function(button) {
  button.addEventListener('click', function() {
    const productId = this.getAttribute('data-product-id');
    Swal.fire({
      title: 'Remove Timepiece?',
      text: "Are you sure you want to remove this piece from your bag?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ff7700',
      cancelButtonColor: '#94a3b8',
      confirmButtonText: 'Remove',
      cancelButtonText: 'Keep'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch('/removeFromCart', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ productId: productId })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            Swal.fire({
              title: 'Removed!',
              text: 'Item has been removed from your bag.',
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.reload();
            });
          } else {
            Swal.fire('Error', data.message || 'Failed to remove item', 'error');
          }
        })
        .catch(error => {
          Swal.fire('Error', 'An error occurred while removing item.', 'error');
        });
      }
    });
  });
});

document.addEventListener('DOMContentLoaded', function() {
  const updateSubtotal = () => {
    let subtotal = 0;
    document.querySelectorAll('.item-total').forEach(totalElem => {
      subtotal += parseFloat(totalElem.textContent.replace('₹', ''));
    });
    const subtotalFormatted = `₹${subtotal.toFixed(2)}`;
    const subtotalEl = document.getElementById('subtotal');
    if (subtotalEl) subtotalEl.textContent = subtotalFormatted;
  };

  const updateCartItem = (productId, quantity) => {
    return fetch('/updateCart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ productId, quantity }] })
    })
    .then(response => response.json())
    .then(data => {
      if (!data.success) {
        throw new Error(data.message || "Failed to update cart");
      }
      return data;
    });
  };

  document.querySelectorAll('.increase').forEach(button => {
    button.addEventListener('click', function() {
      const row = this.closest('tr');
      const qtyInput = row.querySelector('.qty');
      const productId = row.getAttribute('data-product-id');
      let qty = parseInt(qtyInput.value);
      
      if (qty < 4) {
        const newQty = qty + 1;
        const price = parseFloat(row.querySelector('td[data-label="Price"] span').textContent.replace('₹', ''));
        
        updateCartItem(productId, newQty)
          .then(() => {
            qtyInput.value = newQty;
            row.querySelector('.item-total').textContent = `₹${(price * newQty).toFixed(2)}`;
            updateSubtotal();
          })
          .catch(error => {
            Swal.fire("Notice", error.message, "warning");
          });
      } else {
        Swal.fire("Limit Reached", "The maximum allocation per product is 4 units.", "info");
      }
    });
  });

  document.querySelectorAll('.reduced').forEach(button => {
    button.addEventListener('click', function() {
      const row = this.closest('tr');
      const qtyInput = row.querySelector('.qty');
      const productId = row.getAttribute('data-product-id');
      let qty = parseInt(qtyInput.value);
      
      if (qty > 1) {
        const newQty = qty - 1;
        const price = parseFloat(row.querySelector('td[data-label="Price"] span').textContent.replace('₹', ''));
        
        updateCartItem(productId, newQty)
          .then(() => {
            qtyInput.value = newQty;
            row.querySelector('.item-total').textContent = `₹${(price * newQty).toFixed(2)}`;
            updateSubtotal();
          })
          .catch(error => {
            Swal.fire("Notice", error.message, "warning");
          });
      } else {
        Swal.fire("Minimum Allocation", "Minimum quantity is 1 unit.", "warning");
      }
    });
  });
});
</script>

<%- include("../../views/partials/user/footer") %>