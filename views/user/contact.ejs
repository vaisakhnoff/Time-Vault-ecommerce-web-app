<%- include("../../views/partials/user/header") %>

<main class="vault-page-wrapper">
    <div class="container">
        <!-- Breadcrumb Pill -->
        <div class="vault-breadcrumb-pill">
            <a href="/">Home</a>
            <span class="sep"><i class="ti-angle-right"></i></span>
            <span class="active-crumb">Vault Concierge & Advisory</span>
        </div>

        <!-- Header Title -->
        <div class="mb-4">
            <h1 class="vault-page-title">Vault <span class="vault-gold-text">Concierge</span></h1>
            <p class="vault-page-subtitle">Speak with our certified horology advisors regarding acquisitions, servicing, and provenance.</p>
        </div>

        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="vault-card h-100">
                    <h5 style="font-weight: 800; color: #0f172a; margin-bottom: 20px;">Advisory Headquarters</h5>
                    
                    <div class="d-flex mb-4" style="gap: 15px;">
                        <div style="width: 40px; height: 40px; border-radius: 10px; background: #fff7ed; color: #ff7700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="ti-location-pin" style="font-size: 18px;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Time Vault Salon</h6>
                            <p style="color: #64748b; font-size: 14px; margin-bottom: 0;">Clock Tower Square, Horology Row, Zurich / Mumbai</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4" style="gap: 15px;">
                        <div style="width: 40px; height: 40px; border-radius: 10px; background: #fff7ed; color: #ff7700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="ti-headphone-alt" style="font-size: 18px;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Private Hotline</h6>
                            <p style="color: #64748b; font-size: 14px; margin-bottom: 0;">+91 98765 43210 &bull; Mon - Sat 9am - 8pm</p>
                        </div>
                    </div>

                    <div class="d-flex" style="gap: 15px;">
                        <div style="width: 40px; height: 40px; border-radius: 10px; background: #fff7ed; color: #ff7700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="ti-email" style="font-size: 18px;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Concierge Email</h6>
                            <p style="color: #64748b; font-size: 14px; margin-bottom: 0;">concierge@timevault.com</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="vault-card">
                    <h5 style="font-weight: 800; color: #0f172a; margin-bottom: 20px;">Send Private Inquiry</h5>
                    <form class="contact_form" action="/contact/submit" method="post" id="contactForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Your Name</label>
                                <input type="text" class="form-control" id="name" name="name" placeholder="Lord / Lady / Collector Name" required style="border-radius: 8px; padding: 10px 14px; border: 1px solid #e2e8f0;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Email Address</label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="name@domain.com" required style="border-radius: 8px; padding: 10px 14px; border: 1px solid #e2e8f0;">
                            </div>
                            <div class="col-12 mb-3">
                                <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Inquiry Subject</label>
                                <input type="text" class="form-control" id="subject" name="subject" placeholder="e.g. Allocation request for Rolex GMT Master II" required style="border-radius: 8px; padding: 10px 14px; border: 1px solid #e2e8f0;">
                            </div>
                            <div class="col-12 mb-4">
                                <label style="font-weight: 600; color: #0f172a; font-size: 13px;">Message Details</label>
                                <textarea class="form-control" name="message" id="message" rows="4" placeholder="Detail your horological request..." required style="border-radius: 8px; padding: 12px 14px; border: 1px solid #e2e8f0;"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="vault-btn-primary" style="cursor: pointer; padding: 12px 30px;">
                                    <span>Transmit Inquiry</span>
                                    <i class="ti-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const message = urlParams.get('message');
        const status = urlParams.get('status');

        if (message) {
            Swal.fire({
                icon: status === 'success' ? 'success' : 'error',
                title: status === 'success' ? 'Inquiry Received' : 'Error',
                text: message,
                confirmButtonColor: '#ff7700'
            });
        }

        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;

            if (!name || !email || !subject || !message) {
                Swal.fire({
                    icon: 'error',
                    title: 'Incomplete Details',
                    text: 'Please complete all required fields.',
                    confirmButtonColor: '#ff7700'
                });
                return;
            }

            this.submit();
        });
    });
</script>

<%- include("../../views/partials/user/footer") %>