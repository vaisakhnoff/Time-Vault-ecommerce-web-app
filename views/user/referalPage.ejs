<%- include("../../views/partials/user/header") %>

<style>
.referral-card {
    background: white;
    border-radius: var(--vault-radius-lg);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    border: 1px solid #e2e8f0;
    overflow: hidden;
    margin: 0 auto 30px;
    max-width: 950px;
}

.referral-header {
    background: var(--vault-gold-gradient);
    padding: 40px 30px;
    text-align: center;
    color: white;
}

.referral-header h2 {
    font-size: 2.3em;
    margin-bottom: 10px;
    font-weight: 800;
    color: #ffffff;
}

.referral-header p {
    font-size: 1.1em;
    opacity: 0.95;
    margin-bottom: 0;
}

.how-it-works {
    background: #f8fafc;
    padding: 35px 30px;
    border-bottom: 1px solid #e2e8f0;
}

.steps-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
}

.step-item {
    flex: 1;
    min-width: 250px;
    text-align: center;
    padding: 15px;
}

.step-number {
    width: 44px;
    height: 44px;
    background: var(--vault-gold-gradient);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    font-weight: 800;
    font-size: 16px;
    box-shadow: var(--vault-gold-glow);
}

.step-item h4 {
    color: #0f172a;
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 8px;
}

.step-item p {
    color: #64748b;
    font-size: 14px;
}

.referral-code-section {
    padding: 40px 30px;
    text-align: center;
}

.code-container {
    background: #fff7ed;
    border: 2px dashed #fed7aa;
    border-radius: 14px;
    padding: 16px 28px;
    display: inline-flex;
    align-items: center;
    gap: 15px;
    margin: 20px 0;
}

#referral-code {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #ea580c;
}

.copy-btn {
    background: var(--vault-gold-gradient);
    color: white;
    border: none;
    padding: 10px 22px;
    border-radius: 9999px;
    cursor: pointer;
    font-weight: 700;
    font-size: 14px;
    box-shadow: var(--vault-gold-glow);
    transition: all 0.2s ease;
}

.copy-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 122, 0, 0.4);
}

.earnings-badge {
    background: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
    padding: 12px 28px;
    border-radius: 9999px;
    display: inline-block;
    font-size: 1.1em;
    font-weight: 700;
    margin: 15px 0;
}

.redeemed-users {
    padding: 30px;
    border-top: 1px solid #e2e8f0;
}

.users-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 15px;
}

.user-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 12px 16px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-icon {
    width: 36px;
    height: 36px;
    background: #fff7ed;
    color: #ff7700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

@media (max-width: 768px) {
    .referral-header h2 {
        font-size: 1.8em;
    }
    .code-container {
        flex-direction: column;
        width: 100%;
    }
}
</style>

<main class="vault-page-wrapper">
  <div class="container">
    <!-- Breadcrumb Pill -->
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/userProfile">Account</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Referral Program</span>
    </div>

    <div class="referral-card">
        <div class="referral-header">
            <h2>Invite Patrons & Earn Allocation Credits</h2>
            <p>Share your exclusive invite code. When a friend joins the Vault, you both receive ₹100 credit.</p>
        </div>

        <div class="how-it-works">
            <h4 class="text-center mb-4" style="font-weight: 800; color: #0f172a;">Provenance Protocol</h4>
            <div class="steps-container">
                <div class="step-item">
                    <div class="step-number">1</div>
                    <h4>Share Invite</h4>
                    <p>Share your unique patron referral code with fellow horology enthusiasts.</p>
                </div>
                <div class="step-item">
                    <div class="step-number">2</div>
                    <h4>Account Creation</h4>
                    <p>Your guest registers their Time Vault account using your invite code.</p>
                </div>
                <div class="step-item">
                    <div class="step-number">3</div>
                    <h4>Instant Allocation</h4>
                    <p>Both wallets immediately receive ₹100 in Vault allocation credits.</p>
                </div>
            </div>
        </div>

        <div class="referral-code-section">
            <h4 style="font-weight: 800; color: #0f172a;">Your Personal Invite Code</h4>
            <div class="code-container">
                <strong id="referral-code"><%= user.referalCode %></strong>
                <button class="copy-btn" onclick="copyReferralCode()">
                    <i class="ti-files mr-1"></i> Copy Code
                </button>
            </div>
            
            <div>
                <div class="earnings-badge">
                    Total Credits Earned: ₹<%= ((user.redeemedUsers ? user.redeemedUsers.length : 0) * 100) %>
                </div>
            </div>
        </div>

        <% if (user.redeemedUsers && user.redeemedUsers.length > 0) { %>
        <div class="redeemed-users">
            <h5 style="font-weight: 800; color: #0f172a; margin-bottom: 15px;">Enrolled Patrons</h5>
            <div class="users-list">
                <% user.redeemedUsers.forEach(function(redeemedUser) { %>
                    <div class="user-item">
                        <div class="user-icon">
                            <i class="ti-user"></i>
                        </div>
                        <div>
                            <strong style="color: #0f172a; font-size: 14px;"><%= redeemedUser.name || 'Collector' %></strong>
                            <small class="text-muted d-block"><%= redeemedUser.email || 'Verified' %></small>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
  </div>
</main>

<script>
    function copyReferralCode() {
        var codeElement = document.getElementById("referral-code");
        var text = codeElement.innerText.trim();
        if (text === 'Not Available') {
            Swal.fire('Notice', 'No referral code available', 'info');
            return;
        }
        navigator.clipboard.writeText(text)
        .then(() => {
            const copyBtn = document.querySelector('.copy-btn');
            const originalHtml = copyBtn.innerHTML;
            copyBtn.innerHTML = '<i class="ti-check mr-1"></i> Copied!';
            setTimeout(() => {
                copyBtn.innerHTML = originalHtml;
            }, 2000);
        })
        .catch(err => {
            console.error("Failed to copy referral code: ", err);
            Swal.fire('Notice', 'Failed to copy code', 'error');
        });
    }
</script>

<%- include("../../views/partials/user/footer") %>