<%- include("../../views/partials/user/header") %>
<style>
 .otp-input {
   width: 100%;
   padding: 12px 14px;
   font-size: 18px;
   text-align: center;
   letter-spacing: 4px;
   font-weight: 700;
   border-radius: 8px;
   border: 1px solid #e2e8f0;
   transition: all 0.3s;
 }

 .otp-input:focus {
   border-color: #ff7700;
   outline: none;
   box-shadow: 0 0 0 3px rgba(255, 119, 0, 0.15);
 }

 .resend-btn {
   display: inline-block;
   font-size: 14px;
   color: #ea580c;
   background: none;
   border: none;
   cursor: pointer;
   font-weight: 600;
   margin-top: 15px;
 }
</style>

<main class="vault-page-wrapper">
  <div class="container">
    <div class="vault-breadcrumb-pill">
      <a href="/">Home</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <a href="/userProfile">Profile</a>
      <span class="sep"><i class="ti-angle-right"></i></span>
      <span class="active-crumb">Verify Email Update</span>
    </div>

    <div class="vault-card text-center" style="max-width: 440px; margin: 0 auto;">
       <h4 style="font-weight: 800; color: #0f172a; margin-bottom: 8px;">Email Verification</h4>
       <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Enter the code dispatched to verify your new email address.</p>
       <form action="/verifyEmailOtp" method="post">
           <div class="form-group mb-3 text-left">
               <label for="otp" style="font-weight: 600; color: #0f172a; font-size: 13px;">Enter Security Code</label>
               <input type="text" id="otp" name="otp" class="otp-input" required placeholder="Enter OTP">
           </div>
           <button type="submit" class="vault-btn-primary w-100 justify-content-center" style="cursor: pointer;">Verify OTP</button>
           <div class="otp-timer mt-3" style="font-size: 14px; font-weight: 600; color: #ea580c;">
               <span id="otpTimer">OTP Expires in: 1:00</span>
           </div>
           <div>
             <button type="button" onclick="resendOTP()" class="resend-btn">Resend OTP</button>
           </div>
           <% if (locals.message && message.length > 0) { %>
               <div class="alert alert-danger mt-3" style="font-size: 13px;">
                   <%= message %>
               </div>
           <% } %>
       </form>
    </div>
  </div>
</main>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
 function startOTPTimer(durationInSeconds) {
   let timer = durationInSeconds;
   const timerElement = document.getElementById('otpTimer');
   const countdown = setInterval(function () {
     const minutes = Math.floor(timer / 60);
     const seconds = timer % 60;


     timerElement.textContent = `OTP Expires in: ${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;


     if (--timer < 0) {
       clearInterval(countdown);
       timerElement.textContent = 'OTP Expired';
     }
   }, 1000);
 }


 function resendOTP() {
   $.ajax({
     type: 'POST',
     url: '/resend-otp',
     success: function (response) {
       if (response.success) {
         startOTPTimer(60);
       } else {
         alert('Failed to resend OTP. Please try again.');
       }
     },
     error: function () {
       alert('Error occurred while resending OTP. Please try again.');
     }
   });
 }
 startOTPTimer(60);
</script>


<%- include("../../views/partials/user/footer") %>


