<%- include("../../views/partials/admin/header") %>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Customer Management</h2>
            <p class="content-subtitle">View and manage registered user accounts</p>
        </div>
        <div>
            <form action="/admin/users/" method="get" class="d-flex align-items-center">
                <div class="tv-search-bar">
                    <i class="material-icons md-search text-muted"></i>
                    <input type="text" placeholder="Search customers by name or email..." name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
                    <button type="submit">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="font-size: 1rem; font-weight: 600;">Registered Customers</h5>
            <span class="badge bg-light text-dark" style="border: 1px solid var(--tv-border); font-size: 0.8rem;">
                Total on Page: <%= data.length %>
            </span>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive-modern">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th>Account Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% for(let i = 0; i < data.length; i++) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="tv-user-avatar">
                                                <%= (data[i].firstName ? data[i].firstName.charAt(0) : 'U').toUpperCase() %><%= (data[i].lastName ? data[i].lastName.charAt(0) : '').toUpperCase() %>
                                            </div>
                                            <div>
                                                <div style="font-weight: 600; color: var(--tv-text-main);">
                                                    <%= data[i].firstName %> <%= data[i].lastName %>
                                                </div>
                                                <div style="font-size: 0.75rem; color: var(--tv-text-muted);">
                                                    ID: <%= data[i]._id.toString().slice(-6) %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="color: var(--tv-text-main); font-weight: 500;"><%= data[i].email %></span>
                                    </td>
                                    <td>
                                        <span class="text-muted"><%= data[i].phoneNumber || 'N/A' %></span>
                                    </td>
                                    <td>
                                        <% if(data[i].isBlocked) { %>
                                            <span class="tv-badge tv-badge-danger">
                                                <span class="tv-badge-dot"></span> Blocked
                                            </span>
                                        <% } else { %>
                                            <span class="tv-badge tv-badge-success">
                                                <span class="tv-badge-dot"></span> Active
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <% if(data[i].isBlocked === false) { %>
                                            <button class="btn btn-sm btn-danger action-btn blockCustomer" data-id="<%= data[i]._id %>">
                                                <i class="material-icons md-block" style="font-size: 1rem;"></i> Block
                                            </button>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-success action-btn unblockCustomer" data-id="<%= data[i]._id %>">
                                                <i class="material-icons md-check_circle" style="font-size: 1rem;"></i> Unblock
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="material-icons md-person_off" style="font-size: 2.5rem; opacity: 0.5;"></i>
                                        <p class="mt-2 mb-0">No customers found matching your criteria</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (totalPages > 1) { %>
            <div class="card-footer bg-white border-top py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0">
                        <% for(let i = 0; i < totalPages; i++) { %>
                            <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %>">
                                    <%= i + 1 %>
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</section>

<%- include("../../views/partials/admin/footer") %>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Using event delegation to catch clicks on block/unblock buttons
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.blockCustomer, .unblockCustomer');
    if (!button) return;

    event.preventDefault();
    const id = button.getAttribute('data-id');
    const isBlocking = button.classList.contains('blockCustomer');

    if (isBlocking) {
      const result = await Swal.fire({
        title: 'Block User?',
        text: 'Are you sure you want to block this user?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Yes, block user',
        cancelButtonText: 'Cancel'
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch(`/admin/blockCustomer?id=${id}`);
          const data = await response.json();
          
          if (data.success) {
            await Swal.fire({
              icon: 'success',
              title: 'User Blocked',
              text: 'The user has been blocked successfully',
              confirmButtonColor: '#10b981'
            });
            location.reload();
          } else {
            await Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message || 'Failed to block user',
              confirmButtonColor: '#ef4444'
            });
          }
        } catch (error) {
          console.error('Error blocking customer:', error);
          await Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to block user. Please try again.',
            confirmButtonColor: '#ef4444'
          });
        }
      }
    } else {
      const result = await Swal.fire({
        title: 'Unblock User?',
        text: 'Are you sure you want to unblock this user?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Yes, unblock user',
        cancelButtonText: 'Cancel'
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch(`/admin/unblockCustomer?id=${id}`);
          const data = await response.json();
          
          if (data.success) {
            await Swal.fire({
              icon: 'success',
              title: 'User Unblocked',
              text: 'The user has been unblocked successfully',
              confirmButtonColor: '#10b981'
            });
            location.reload();
          } else {
            await Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message || 'Failed to unblock user',
              confirmButtonColor: '#ef4444'
            });
          }
        } catch (error) {
          console.error('Error unblocking customer:', error);
          await Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to unblock user. Please try again.',
            confirmButtonColor: '#ef4444'
          });
        }
      }
    }
  });
});
</script>
