<%- include("../../views/partials/admin/header") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Brand Management</h2>
            <p class="content-subtitle">Manage watchmaker brands, logos, and promotional offers</p>
        </div>
        <div>
            <a href="/admin/add-brand" class="btn btn-primary">
                <i class="material-icons md-add_circle" style="font-size: 1.1rem;"></i> Add New Brand
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="font-size: 1rem; font-weight: 600;">Active Brands</h5>
            <span class="badge bg-light text-dark" style="border: 1px solid var(--tv-border); font-size: 0.8rem;">
                Page <%= currentPage %> of <%= totalPages %>
            </span>
        </div>
        <div class="card-body p-0">
            <% if (brands && brands.length > 0) { %>
                <div class="table-responsive-modern">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Brand</th>
                                <th>Logo</th>
                                <th>Created Date</th>
                                <th>Special Offer</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% brands.forEach(brand => { %>
                                <tr data-brand-id="<%= brand._id %>">
                                    <td>
                                        <div style="font-weight: 700; color: var(--tv-text-main); font-size: 0.95rem;">
                                            <%= brand.brandName %>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="width: 56px; height: 56px; border-radius: var(--tv-radius-sm); border: 1px solid var(--tv-border); background: #fff; padding: 4px; display: flex; align-items: center; justify-content: center;">
                                            <img src="/uploads/product-images/<%= brand.brandImage[0] %>" 
                                                 alt="<%= brand.brandName %>" 
                                                 style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted" style="font-size: 0.85rem;">
                                            <%= new Date(brand.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </span>
                                    </td>
                                    <td class="offer-cell">
                                        <% if (brand.brandOffer > 0) { %>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="tv-badge tv-badge-info">
                                                    <span class="tv-badge-dot"></span> <%= brand.brandOffer %>% OFF
                                                </span>
                                                <button class="btn btn-sm btn-outline-danger remove-offer" data-id="<%= brand._id %>">
                                                    Remove
                                                </button>
                                            </div>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-outline-primary add-offer" data-id="<%= brand._id %>">
                                                <i class="material-icons md-local_offer" style="font-size: 0.9rem;"></i> Add Offer
                                            </button>
                                        <% } %>
                                    </td>
                                    <td class="status-cell">
                                        <% if (brand.isBlocked) { %>
                                            <span class="tv-badge tv-badge-danger">
                                                <span class="tv-badge-dot"></span> Unlisted
                                            </span>
                                        <% } else { %>
                                            <span class="tv-badge tv-badge-success">
                                                <span class="tv-badge-dot"></span> Listed
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="/admin/edit-brand/<%= brand._id %>" class="btn btn-sm btn-primary">
                                                <i class="material-icons md-edit" style="font-size: 0.9rem;"></i> Edit
                                            </a>
                                            <button class="btn btn-sm <%= brand.isBlocked ? 'btn-success' : 'btn-secondary' %> toggle-status" 
                                                    data-id="<%= brand._id %>"
                                                    data-status="<%= brand.isBlocked %>">
                                                <%= brand.isBlocked ? 'List' : 'Unlist' %>
                                            </button>
                                            <button class="btn btn-sm btn-danger delete-brand" data-id="<%= brand._id %>">
                                                <i class="material-icons md-delete" style="font-size: 0.9rem;"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="material-icons md-stars text-muted" style="font-size: 3rem; opacity: 0.5;"></i>
                    <h5 class="mt-2 mb-1">No Brands Registered</h5>
                    <p class="text-muted">Get started by clicking the "+ Add New Brand" button above.</p>
                </div>
            <% } %>
        </div>

        <% if (brands && brands.length > 0 && totalPages > 1) { %>
            <div class="card-footer bg-white border-top py-3">
                <nav aria-label="Brand pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage - 1 %>">&laquo;</a>
                        </li>
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentPage + 1 %>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</section>

<script>
function showToast(message, type = 'success') {
  Swal.fire({
    toast: true,
    position: 'top-end',
    icon: type,
    title: message,
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true
  });
}

// Handle status toggle (list/unlist)
document.querySelectorAll('.toggle-status').forEach(button => {
  button.addEventListener('click', async function() {
    const brandId = this.dataset.id;
    const currentStatus = this.dataset.status === 'true';
    
    try {
      const response = await fetch(`/admin/toggle-brand-status/${brandId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isBlocked: !currentStatus })
      });

      const data = await response.json();
      if (data.success) {
        location.reload();
      }
    } catch (error) {
      console.error('Error:', error);
      showToast('Failed to update brand status', 'error');
    }
  });
});

// Delete functionality
document.querySelectorAll('.delete-brand').forEach(button => {
  button.addEventListener('click', async function() {
    const brandId = this.dataset.id;
    const brandName = this.closest('tr').querySelector('td').textContent.trim();
    
    const result = await Swal.fire({
      title: 'Delete Brand?',
      text: `Are you sure you want to delete "${brandName}"?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, delete',
      cancelButtonText: 'Cancel'
    });

    if (result.isConfirmed) {
      try {
        const response = await fetch(`/admin/delete-brand/${brandId}`, {
          method: 'POST'
        });
        const data = await response.json();
        
        if (data.success) {
          const row = this.closest('tr');
          row.style.transition = 'opacity 0.4s ease';
          row.style.opacity = '0';
          setTimeout(() => row.remove(), 400);
          showToast('Brand deleted successfully');
        } else {
          showToast(data.message || 'Failed to delete brand', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to delete brand', 'error');
      }
    }
  });
});

function attachAddOfferListener(button) {
  button.addEventListener('click', async function() {
    const brandId = this.dataset.id;
    const brandName = this.closest('tr').querySelector('td').textContent.trim();
    
    const { value: offerPercentage } = await Swal.fire({
      title: `Add Offer for ${brandName}`,
      input: 'number',
      inputLabel: 'Discount Percentage (%)',
      inputAttributes: { min: '1', max: '99', step: '1' },
      inputValue: 10,
      showCancelButton: true,
      confirmButtonColor: '#4f46e5',
      confirmButtonText: 'Apply Offer'
    });

    if (offerPercentage) {
      try {
        const response = await fetch('/admin/add-brand-offer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ brandId, offerPercentage })
        });
        const data = await response.json();
        if (data.success) {
          showToast('Offer added successfully');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.message || 'Failed to add offer', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to add offer', 'error');
      }
    }
  });
}

function attachRemoveOfferListener(button) {
  button.addEventListener('click', async function() {
    const brandId = this.dataset.id;
    const brandName = this.closest('tr').querySelector('td').textContent.trim();
    
    const result = await Swal.fire({
      title: 'Remove Offer?',
      text: `Remove discount offer from "${brandName}"?`,
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      confirmButtonText: 'Yes, remove',
      cancelButtonText: 'Cancel'
    });

    if (result.isConfirmed) {
      try {
        const response = await fetch('/admin/remove-brand-offer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ brandId })
        });
        const data = await response.json();
        if (data.success) {
          showToast('Offer removed successfully');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.message || 'Failed to remove offer', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to remove offer', 'error');
      }
    }
  });
}

document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.add-offer').forEach(button => attachAddOfferListener(button));
  document.querySelectorAll('.remove-offer').forEach(button => attachRemoveOfferListener(button));
});
</script>

<%- include("../../views/partials/admin/footer") %>