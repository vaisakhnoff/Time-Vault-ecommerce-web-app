<%- include("../../views/partials/admin/header") %>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Order Management</h2>
            <p class="content-subtitle">Track, filter, and process customer purchases</p>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <form method="GET" action="/admin/orders" class="row g-3 align-items-center">
                <div class="col-md-5 col-12">
                    <div class="tv-search-bar" style="max-width: 100%;">
                        <i class="material-icons md-search text-muted"></i>
                        <input type="text" name="search" placeholder="Search by Order ID..." value="<%= search || '' %>">
                    </div>
                </div>
                <div class="col-md-4 col-sm-6 col-12">
                    <select name="status" class="form-select">
                        <option value="">All Order Statuses</option>
                        <option value="Pending" <%= filterStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Shipped" <%= filterStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                        <option value="Out for Delivery" <%= filterStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                        <option value="Delivered" <%= filterStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                        <option value="Cancelled" <%= filterStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6 col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="material-icons md-filter_list" style="font-size: 1rem;"></i> Filter
                    </button>
                    <a href="/admin/orders" class="btn btn-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table Card -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="font-size: 1rem; font-weight: 600;">Customer Orders</h5>
            <% if (orders && orders.length > 0) { %>
                <span class="badge bg-light text-dark" style="border: 1px solid var(--tv-border); font-size: 0.8rem;">
                    Page <%= currentPage %> of <%= totalPages %>
                </span>
            <% } %>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive-modern">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date Placed</th>
                            <th>Customer</th>
                            <th>Total Amount</th>
                            <th>Order Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td>
                                        <span style="font-family: monospace; font-weight: 700; color: var(--tv-primary); font-size: 0.9rem;">
                                            #<%= order.orderId %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1 text-muted" style="font-size: 0.85rem;">
                                            <i class="material-icons md-event" style="font-size: 0.95rem;"></i>
                                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="tv-user-avatar" style="width: 30px; height: 30px; font-size: 0.75rem;">
                                                <%= (order.user && order.user.firstName ? order.user.firstName.charAt(0) : 'U').toUpperCase() %>
                                            </div>
                                            <span style="font-weight: 600; color: var(--tv-text-main);">
                                                <%= order.user ? (order.user.firstName + (order.user.lastName ? ' ' + order.user.lastName : '')) : 'Customer' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-weight: 700; color: var(--tv-text-main);">
                                            ₹<%= Number(order.totalAmount).toLocaleString('en-IN') %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (order.orderStatus === 'Delivered') { %>
                                            <span class="tv-badge tv-badge-success">
                                                <span class="tv-badge-dot"></span> Delivered
                                            </span>
                                        <% } else if (order.orderStatus === 'Shipped') { %>
                                            <span class="tv-badge tv-badge-info">
                                                <span class="tv-badge-dot"></span> Shipped
                                            </span>
                                        <% } else if (order.orderStatus === 'Out for Delivery') { %>
                                            <span class="tv-badge tv-badge-warning">
                                                <span class="tv-badge-dot"></span> Out for Delivery
                                            </span>
                                        <% } else if (order.orderStatus === 'Cancelled') { %>
                                            <span class="tv-badge tv-badge-danger">
                                                <span class="tv-badge-dot"></span> Cancelled
                                            </span>
                                        <% } else { %>
                                            <span class="tv-badge tv-badge-secondary">
                                                <span class="tv-badge-dot"></span> <%= order.orderStatus || 'Pending' %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a href="/admin/order/<%= order.orderId %>" class="btn btn-sm btn-outline-primary">
                                            <i class="material-icons md-visibility" style="font-size: 0.95rem;"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="material-icons md-shopping_bag" style="font-size: 2.5rem; opacity: 0.5;"></i>
                                        <p class="mt-2 mb-0">No orders found matching your search or filter</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (totalPages > 1) { %>
            <div class="card-footer bg-white border-top py-3">
                <nav aria-label="Order pagination">
                    <ul class="pagination mb-0">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="/admin/orders?page=<%= currentPage - 1 %>&search=<%= search || '' %>&status=<%= filterStatus || '' %>">&laquo;</a>
                            </li>
                        <% } %>
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="/admin/orders?page=<%= i %>&search=<%= search || '' %>&status=<%= filterStatus || '' %>"><%= i %></a>
                            </li>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="/admin/orders?page=<%= currentPage + 1 %>&search=<%= search || '' %>&status=<%= filterStatus || '' %>">&raquo;</a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</section>

<%- include("../../views/partials/admin/footer") %>