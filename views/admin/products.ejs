<%- include("../../views/partials/admin/header") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css" />

<section class="content-main">
  <!-- Content Header -->
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Product Management</h2>
      <p class="content-subtitle">Catalog, pricing, stock levels, and promotional discounts</p>
    </div>
    <div class="d-flex align-items-center gap-3">
      <form action="" method="get" class="d-flex align-items-center">
        <div class="tv-search-bar">
          <i class="material-icons md-search text-muted"></i>
          <input 
            type="text" 
            placeholder="Search products, brands or categories..."
            name="search"
            value="<%= searchQuery || '' %>"
          />
          <button type="submit">Search</button>
        </div>
      </form>
      <a href="/admin/addProducts" class="btn btn-primary text-nowrap">
        <i class="material-icons md-add_circle" style="font-size: 1.1rem;"></i> Add Product
      </a>
    </div>
  </div>

  <!-- Products Table Card -->
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0" style="font-size: 1rem; font-weight: 600;">Inventory Catalog</h5>
      <span class="badge bg-light text-dark" style="border: 1px solid var(--tv-border); font-size: 0.8rem;">
        Total Products: <%= total.toLocaleString() %>
      </span>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive-modern">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Product Name</th>
              <th>Brand</th>
              <th>Category</th>
              <th>Regular Price</th>
              <th>Sale Price</th>
              <th>Active Offers</th>
              <th>Stock</th>
              <th>Manage Offers</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(function(product) { %>
                <tr data-product-id="<%= product._id %>">
                  <td>
                    <div style="font-weight: 600; color: var(--tv-text-main); max-width: 220px;" class="text-truncate" title="<%= product.productName %>">
                      <%= product.productName %>
                    </div>
                  </td>
                  <td>
                    <span class="text-muted" style="font-size: 0.85rem;"><%= product.brand ? product.brand.brandName : 'N/A' %></span>
                  </td>
                  <td>
                    <span class="tv-badge tv-badge-secondary">
                      <%= product.category?.name || "Uncategorized" %>
                    </span>
                  </td>
                  <td>
                    <span class="text-muted" style="text-decoration: line-through; font-size: 0.85rem;">
                      ₹<%= product.regularPrice.toLocaleString('en-IN') %>
                    </span>
                  </td>
                  <td data-price-type="sale">
                    <span style="font-weight: 700; color: var(--tv-primary);">
                      ₹<%= product.salePrice.toLocaleString('en-IN') %>
                    </span>
                  </td>
                  <td id="offer-value-<%= product._id %>">
                    <% if(product.category?.categoryOffer || product.brand?.brandOffer || product.productOffer) { %>
                      <div class="d-flex flex-wrap gap-1">
                        <% if(product.category?.categoryOffer) { %>
                          <span class="tv-badge tv-badge-info">Cat: <%= product.category.categoryOffer %>%</span>
                        <% } %>
                        <% if(product.brand?.brandOffer) { %>
                          <span class="tv-badge tv-badge-secondary">Brand: <%= product.brand.brandOffer %>%</span>
                        <% } %>
                        <% if(product.productOffer) { %>
                          <span class="tv-badge tv-badge-success">Prod: <%= product.productOffer %>%</span>
                        <% } %>
                        <span class="tv-badge tv-badge-warning">
                          Max: <%= Math.max(product.category?.categoryOffer || 0, product.brand?.brandOffer || 0, product.productOffer || 0) %>%
                        </span>
                      </div>
                    <% } else { %>
                      <span class="text-muted small">No Offers</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (product.quantity <= 0) { %>
                      <span class="tv-badge tv-badge-danger">Out of Stock</span>
                    <% } else if (product.quantity < 10) { %>
                      <span class="tv-badge tv-badge-warning"><%= product.quantity %> Left</span>
                    <% } else { %>
                      <span class="tv-badge tv-badge-success"><%= product.quantity %> In Stock</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group-action">
                      <% if(product.productOffer) { %>
                        <button class="btn btn-sm btn-outline-danger action-btn" 
                                data-id="<%= product._id %>"
                                onclick="removeProductOffer('<%= product._id %>')">
                          <i class="material-icons md-close" style="font-size: 0.9rem;"></i> Remove
                        </button>
                      <% } else { %>
                        <button class="btn btn-sm btn-outline-primary action-btn" 
                                data-id="<%= product._id %>"
                                onclick="addProductOffer('<%= product._id %>')">
                          <i class="material-icons md-local_offer" style="font-size: 0.9rem;"></i> Add Offer
                        </button>
                      <% } %>
                    </div>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-2">
                      <a href="/admin/editProduct/<%= product._id %>" class="btn btn-sm btn-primary">
                        <i class="material-icons md-edit" style="font-size: 0.9rem;"></i> Edit
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="9" class="text-center py-5">
                  <div class="text-muted">
                    <i class="material-icons md-shopping_bag" style="font-size: 2.5rem; opacity: 0.5;"></i>
                    <p class="mt-2 mb-0">No products found matching your search</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Enhanced pagination -->
    <% if (totalPages > 1) { %>
      <div class="card-footer bg-white border-top py-3">
        <nav aria-label="Product pagination">
          <ul class="pagination mb-0">
            <% if (currentPage > 0) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">&laquo;</a>
              </li>
            <% } else { %>
              <li class="page-item disabled">
                <span class="page-link">&laquo;</span>
              </li>
            <% } %>

            <% for(let i = 0; i < totalPages; i++) { %>
              <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %>">
                  <%= i + 1 %>
                </a>
              </li>
            <% } %>

            <% if (currentPage < totalPages - 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + searchQuery : '' %>">&raquo;</a>
              </li>
            <% } else { %>
              <li class="page-item disabled">
                <span class="page-link">&raquo;</span>
              </li>
            <% } %>
          </ul>
        </nav>
        <div class="text-center mt-2">
          <small class="text-muted">
            Showing <%= (currentPage * perPage) + 1 %> to <%= Math.min((currentPage + 1) * perPage, total) %> of <%= total.toLocaleString() %> products
          </small>
        </div>
      </div>
    <% } %>
  </div>
</section>

<!-- Offer & Product Management Scripts -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    function updateButtonState(button, isBlocked) {
      if (isBlocked) {
        button.innerHTML = '<i class="material-icons md-lock_open" style="font-size: 0.9rem;"></i> Unblock';
        button.classList.remove("btn-danger", "block-button");
        button.classList.add("btn-success", "unblock-button");
        button.replaceWith(button.cloneNode(true));
        button = document.querySelector(`[data-id="${button.dataset.id}"]`);
        button.addEventListener("click", () => {
          sendRequest("/admin/unblockProduct", button.dataset.id, button);
        });
      } else {
        button.innerHTML = '<i class="material-icons md-block" style="font-size: 0.9rem;"></i> Block';
        button.classList.remove("btn-success", "unblock-button");
        button.classList.add("btn-danger", "block-button");
        button.replaceWith(button.cloneNode(true));
        button = document.querySelector(`[data-id="${button.dataset.id}"]`);
        button.addEventListener("click", () => {
          sendRequest("/admin/blockProduct", button.dataset.id, button);
        });
      }
    }
    
    function sendRequest(url, productId, button) {
      fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: productId })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          let message = data.product.isBlocked
            ? "Product blocked successfully!"
            : "Product unblocked successfully!";
          Swal.fire({
            icon: 'success',
            title: 'Success',
            text: message,
            timer: 1500,
            showConfirmButton: false
          });
          updateButtonState(button, data.product.isBlocked);
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || "Operation failed"
          });
        }
      })
      .catch(error => {
        Swal.fire({ icon: 'error', title: 'Error', text: error.message });
        console.error("Error:", error);
      });
    }
    
    document.querySelectorAll(".block-button").forEach(button => {
      button.addEventListener("click", () => {
        sendRequest("/admin/blockProduct", button.dataset.id, button);
      });
    });
    
    document.querySelectorAll(".unblock-button").forEach(button => {
      button.addEventListener("click", () => {
        sendRequest("/admin/unblockProduct", button.dataset.id, button);
      });
    });
  });

  async function handleProductOffer(action, productId) {
    try {
      let percentage;
      if (action === 'add') {
        const result = await Swal.fire({
          title: 'Add Product Offer',
          input: 'number',
          inputAttributes: { min: 1, max: 99, step: 1 },
          inputValue: 15,
          confirmButtonText: 'Apply Offer',
          showCancelButton: true,
          inputLabel: 'Discount Percentage (%)',
          footer: '<small>Set discount percentage between 1% and 99%</small>'
        });

        if (!result.isConfirmed) return;
        percentage = parseInt(result.value);
      }

      if (action === 'remove') {
        const result = await Swal.fire({
          title: 'Remove Product Offer',
          text: 'Are you sure you want to remove this special offer?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          cancelButtonColor: '#64748b',
          confirmButtonText: 'Yes, remove it',
          cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed) return;
      }

      Swal.fire({
        title: `${action === 'add' ? 'Adding' : 'Removing'} Offer...`,
        text: 'Please wait',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
      });

      const url = `/admin/${action}ProductOffer`;
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          productId,
          ...(percentage && { percentage })
        })
      });

      const data = await response.json();
      
      if (data.success) {
        updateProductDisplay(productId, data);
        await Swal.fire({
          icon: 'success',
          title: `Offer ${action === 'add' ? 'Added' : 'Removed'} Successfully`,
          text: data.message,
          timer: 1500,
          showConfirmButton: false
        });
      } else {
        throw new Error(data.message || `Failed to ${action} offer`);
      }
    } catch (error) {
      console.error(`Error ${action}ing offer:`, error);
      await Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error.message || `An error occurred while ${action}ing the offer`
      });
    }
  }

  function updateProductDisplay(productId, data) {
    const offerValueElement = document.getElementById(`offer-value-${productId}`);
    const buttonContainer = document.querySelector(`button[data-id="${productId}"]`).parentElement;
    const salePriceElement = document.querySelector(`tr[data-product-id="${productId}"] td[data-price-type="sale"]`);
    
    let offerHtml = '';
    if (data.categoryOffer || data.brandOffer || data.productOffer) {
      if (data.categoryOffer) {
        offerHtml += `<span class="tv-badge tv-badge-info">Cat: ${data.categoryOffer}%</span> `;
      }
      if (data.brandOffer) {
        offerHtml += `<span class="tv-badge tv-badge-secondary">Brand: ${data.brandOffer}%</span> `;
      }
      if (data.productOffer) {
        offerHtml += `<span class="tv-badge tv-badge-success">Prod: ${data.productOffer}%</span> `;
      }
      const maxOffer = Math.max(data.categoryOffer || 0, data.brandOffer || 0, data.productOffer || 0);
      offerHtml += `<span class="tv-badge tv-badge-warning">Max: ${maxOffer}%</span>`;
    } else {
      offerHtml = '<span class="text-muted small">No Offers</span>';
    }
    
    const buttonHtml = data.productOffer ? 
      `<button class="btn btn-sm btn-outline-danger action-btn" data-id="${productId}" onclick="removeProductOffer('${productId}')">
         <i class="material-icons md-close" style="font-size: 0.9rem;"></i> Remove
       </button>` :
      `<button class="btn btn-sm btn-outline-primary action-btn" data-id="${productId}" onclick="addProductOffer('${productId}')">
         <i class="material-icons md-local_offer" style="font-size: 0.9rem;"></i> Add Offer
       </button>`;
    
    offerValueElement.innerHTML = offerHtml;
    buttonContainer.innerHTML = buttonHtml;
    
    if (data.newPrice !== undefined && salePriceElement) {
      salePriceElement.innerHTML = `<span style="font-weight: 700; color: var(--tv-primary);">₹${parseFloat(data.newPrice).toLocaleString('en-IN')}</span>`;
    }
  }

  function addProductOffer(productId) {
    handleProductOffer('add', productId);
  }

  function removeProductOffer(productId) {
    handleProductOffer('remove', productId);
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<%- include("../../views/partials/admin/footer") %>