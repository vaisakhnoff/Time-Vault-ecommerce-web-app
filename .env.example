# Database Configuration
MONGODB_URI=mongodb://localhost:27017/your_database_name

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Session Secret
SESSION_SECRET=your_secret_key

# Nodemailer Configuration (Email Service)
NODEMAILER_EMAIL=your_email@example.com
NODEMAILER_PASSWORD=your_email_password

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Max per-transaction amount for online payment, in paise.
# Must match your Razorpay account's domestic transaction limit.
# Example: 2,00,000 rupees = 20000000 paise. Default if unset: 50000000 (₹5,00,000)
RAZORPAY_MAX_AMOUNT_PAISE=20000000

# Cloudinary Configuration (image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
